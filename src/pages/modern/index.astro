---
import Base from '../../layouts/Base.astro';
import { business, brandSuffix, services } from '../../data/content';

const chipColors = [
  'bg-blue-100 text-mod-blue',
  'bg-sky-100 text-sky-600',
  'bg-green-100 text-green-600',
  'bg-amber-100 text-amber-600',
];
const icons = ['▤', '▥', '▦', '▧'];
---
<Base title="Sandoval Fencing & Welding — Custom Metalwork & Fencing | North Texas" bodyClass="bg-white text-mod-ink">
  <header class="sticky top-0 z-40 bg-white/85 backdrop-blur-[10px] border-b border-mod-line">
    <div class="max-w-[1160px] mx-auto px-[26px] flex items-center justify-between h-[76px]">
      <div class="flex items-center gap-[11px]">
        <div class="w-10 h-10 bg-mod-ink rounded-[11px] grid place-items-center text-white font-black text-lg">
          S<span class="text-mod-accent">.</span>
        </div>
        <div>
          <b class="text-[16.5px] font-extrabold tracking-[-0.01em] block leading-[1.05]">{business.shortName}</b>
          <span class="text-[11px] text-mod-grey tracking-[0.12em] uppercase">{brandSuffix}</span>
        </div>
      </div>
      <nav class="flex gap-[30px] items-center">
        <a href="#services" class="hidden min-[861px]:inline text-[14.5px] text-mod-slate font-semibold hover:text-mod-blue">Services</a>
        <a href="#work" class="hidden min-[861px]:inline text-[14.5px] text-mod-slate font-semibold hover:text-mod-blue">Work</a>
        <a href="#process" class="hidden min-[861px]:inline text-[14.5px] text-mod-slate font-semibold hover:text-mod-blue">Process</a>
        <a href={business.phoneHref} class="hidden min-[861px]:inline text-[14.5px] text-mod-slate font-semibold hover:text-mod-blue">{business.phone}</a>
        <a href="#quote" class="inline-flex items-center gap-2 bg-mod-blue border-2 border-mod-blue text-white font-bold px-[26px] py-[14px] rounded-[10px] text-[15px] transition hover:bg-mod-blue-d hover:-translate-y-0.5">Free Estimate</a>
      </nav>
    </div>
  </header>

  <section>
    <div class="max-w-[1160px] mx-auto px-[26px] grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 items-center pt-[60px] pb-[60px] md:pt-[90px] md:pb-[80px]">
      <div>
        <span class="inline-flex items-center gap-2 bg-mod-light text-mod-slate text-[13px] font-semibold px-[14px] py-[7px] rounded-[30px] mb-6">
          <span class="w-2 h-2 rounded-full bg-green-500"></span> Now booking projects across {business.area}
        </span>
        <h1 class="text-[clamp(38px,5.4vw,62px)] font-extrabold leading-[1.1] tracking-[-0.025em]">
          Custom metalwork, <em class="not-italic bg-gradient-to-r from-mod-blue to-mod-accent bg-clip-text text-transparent">done right.</em>
        </h1>
        <p class="text-[19px] text-mod-grey mt-[22px] mb-8 max-w-[500px]">{business.tagline}</p>
        <div class="flex gap-3 flex-wrap">
          <a href="#quote" class="inline-flex items-center gap-2 bg-mod-blue border-2 border-mod-blue text-white font-bold px-[26px] py-[14px] rounded-[10px] text-[15px] transition hover:bg-mod-blue-d hover:-translate-y-0.5">Get Your Free Estimate</a>
          <a href={business.phoneHref} class="inline-flex items-center gap-2 bg-white border-2 border-mod-line text-mod-ink font-bold px-[26px] py-[14px] rounded-[10px] text-[15px] transition hover:border-mod-ink">☎ {business.phone}</a>
        </div>
      </div>
      <div class="relative">
        <div class="relative rounded-[18px] overflow-hidden bg-gradient-to-br from-[#eef2f7] to-[#e2e8f0] border border-mod-line grid place-items-center aspect-[16/11] md:aspect-[4/5]">
          <span class="text-[#94a3b8] text-[13px] font-semibold text-center px-4">◈ Sharp hero photo — a clean finished project</span>
        </div>
        <div class="absolute -bottom-[18px] -left-[18px] bg-white border border-mod-line rounded-[14px] px-5 py-4 shadow-[0_20px_40px_rgba(14,23,38,0.12)]">
          <b class="text-[26px] text-mod-ink tracking-[-0.02em] block">Since {business.since}</b>
          <small class="block text-mod-grey text-[12.5px] font-semibold">Locally owned &amp; operated</small>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-b border-mod-line bg-mod-light">
    <div class="max-w-[1160px] mx-auto px-[26px] grid grid-cols-2 sm:grid-cols-4 gap-5 sm:gap-5 py-[34px]">
      <div><b class="block text-[30px] font-extrabold tracking-[-0.03em]">100%</b><span class="text-mod-grey text-sm font-semibold">Custom-built projects</span></div>
      <div><b class="block text-[30px] font-extrabold tracking-[-0.03em]">{services.length}</b><span class="text-mod-grey text-sm font-semibold">Core services</span></div>
      <div><b class="block text-[30px] font-extrabold tracking-[-0.03em]">Free</b><span class="text-mod-grey text-sm font-semibold">No-pressure estimates</span></div>
      <div><b class="block text-[30px] font-extrabold tracking-[-0.03em]">5★</b><span class="text-mod-grey text-sm font-semibold">Local reputation</span></div>
    </div>
  </div>

  <section id="services" class="py-[92px]">
    <div class="max-w-[1160px] mx-auto px-[26px]">
      <div>
        <div class="text-mod-blue font-bold tracking-[0.14em] uppercase text-[13px] mb-[14px]">Services</div>
        <h2 class="text-[clamp(30px,4vw,46px)] font-extrabold leading-[1.1] tracking-[-0.025em]">What we build</h2>
        <p class="text-mod-grey text-lg mt-[14px] max-w-[560px]">Four things, done to a high standard — each one engineered and welded to fit your property.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-12">
        {services.map((service, i) => (
          <div class="border border-mod-line rounded-[18px] p-[34px] transition bg-white relative overflow-hidden hover:border-mod-ink hover:shadow-[0_18px_40px_rgba(14,23,38,0.08)]">
            <div class={`w-[52px] h-[52px] rounded-[13px] grid place-items-center text-2xl mb-5 ${chipColors[i % chipColors.length]}`}>
              {icons[i % icons.length]}
            </div>
            <h3 class="text-[22px] font-extrabold mb-2 tracking-[-0.025em]">{service.title}</h3>
            <p class="text-mod-grey text-[15.5px]">{service.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="work" class="py-[92px] bg-mod-ink text-white">
    <div class="max-w-[1160px] mx-auto px-[26px]">
      <div>
        <div class="text-mod-accent font-bold tracking-[0.14em] uppercase text-[13px] mb-[14px]">Portfolio</div>
        <h2 class="text-[clamp(30px,4vw,46px)] font-extrabold leading-[1.1] tracking-[-0.025em]">Recent work</h2>
        <p class="text-[#94a3b8] text-lg mt-[14px] max-w-[560px]">A sample of fences, gates, shops, and courts built across the region.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr] gap-4 mt-11">
        <div class="rounded-[18px] overflow-hidden bg-gradient-to-br from-mod-slate to-[#0f172a] border border-[#334155] grid place-items-center aspect-[16/10] md:aspect-auto">
          <span class="text-[#64748b] text-[13px] font-semibold text-center px-4">◈ Large featured project photo</span>
        </div>
        <div class="grid gap-4">
          <div class="rounded-[18px] overflow-hidden bg-gradient-to-br from-mod-slate to-[#0f172a] border border-[#334155] grid place-items-center aspect-[16/9]">
            <span class="text-[#64748b] text-[13px] font-semibold text-center px-4">◈ Gate photo</span>
          </div>
          <div class="rounded-[18px] overflow-hidden bg-gradient-to-br from-mod-slate to-[#0f172a] border border-[#334155] grid place-items-center aspect-[16/9]">
            <span class="text-[#64748b] text-[13px] font-semibold text-center px-4">◈ Shop photo</span>
          </div>
          <div class="rounded-[18px] overflow-hidden bg-gradient-to-br from-mod-slate to-[#0f172a] border border-[#334155] grid place-items-center aspect-[16/9]">
            <span class="text-[#64748b] text-[13px] font-semibold text-center px-4">◈ Court photo</span>
          </div>
        </div>
      </div>
      <p class="text-[#64748b] text-[13px] mt-4">Placeholder tiles — {business.owner}'s real photos will fill these.</p>
    </div>
  </section>

  <section id="process" class="py-[92px]">
    <div class="max-w-[1160px] mx-auto px-[26px]">
      <div>
        <div class="text-mod-blue font-bold tracking-[0.14em] uppercase text-[13px] mb-[14px]">How it works</div>
        <h2 class="text-[clamp(30px,4vw,46px)] font-extrabold leading-[1.1] tracking-[-0.025em]">Simple, straightforward process</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-[46px]">
        <div class="pt-[26px] border-t-[3px] border-mod-ink">
          <div class="text-sm font-extrabold text-mod-blue tracking-[0.1em]">STEP 01</div>
          <h3 class="text-xl font-extrabold my-2 tracking-[-0.025em]">Free Estimate</h3>
          <p class="text-mod-grey text-[15px]">Call or send us your project details. We'll come look and give you an honest, no-pressure quote.</p>
        </div>
        <div class="pt-[26px] border-t-[3px] border-mod-ink">
          <div class="text-sm font-extrabold text-mod-blue tracking-[0.1em]">STEP 02</div>
          <h3 class="text-xl font-extrabold my-2 tracking-[-0.025em]">Custom Plan</h3>
          <p class="text-mod-grey text-[15px]">We design and schedule the build around your property, your needs, and your budget.</p>
        </div>
        <div class="pt-[26px] border-t-[3px] border-mod-ink">
          <div class="text-sm font-extrabold text-mod-blue tracking-[0.1em]">STEP 03</div>
          <h3 class="text-xl font-extrabold my-2 tracking-[-0.025em]">Built to Last</h3>
          <p class="text-mod-grey text-[15px]">We show up on time, do the work right, and leave you with something that holds up for years.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="quote" class="bg-gradient-to-r from-mod-blue to-mod-accent text-white">
    <div class="max-w-[1160px] mx-auto px-[26px] py-[92px] text-center">
      <h2 class="text-[clamp(28px,4vw,44px)] font-extrabold leading-[1.1] tracking-[-0.025em]">Start your project today</h2>
      <p class="text-[19px] my-[14px] mb-[30px] opacity-95">Free estimates. Honest work. Reliable turnaround.</p>
      <a href={business.phoneHref} class="inline-flex items-center gap-2 bg-white border-2 border-white text-mod-blue font-bold px-[26px] py-[14px] rounded-[10px] text-[15px] transition hover:bg-mod-light">Call {business.phone}</a>
      <small class="block mt-[18px] opacity-90 text-sm">Or email {business.owner}: <a href={business.emailHref} class="underline">{business.email}</a></small>
    </div>
  </section>

  <footer class="bg-[#0a0f1a] text-[#94a3b8] pt-14 pb-7">
    <div class="max-w-[1160px] mx-auto px-[26px] grid grid-cols-1 sm:grid-cols-[1.4fr_1fr_1fr] gap-8">
      <div>
        <b class="text-white text-[17px]">{business.legalName}</b>
        <p class="mt-[10px] text-[14.5px]">Custom fencing, gates, shops &amp; pickleball courts across {business.area}. Locally owned since {business.since}.</p>
        <p class="mt-3 text-[14.5px]">
          <span class="inline-block bg-mod-blue/20 text-blue-300 text-[11px] font-bold tracking-[0.13em] uppercase px-3 py-[5px] rounded-[20px]">Draft 3 · Modern</span>
        </p>
      </div>
      <div>
        <h4 class="text-white text-[12.5px] tracking-[0.1em] uppercase mb-3">Contact</h4>
        <p class="text-[14.5px] my-[5px]"><a href={business.phoneHref} class="text-[#cbd5e1] hover:text-white">{business.phone}</a></p>
        <p class="text-[14.5px] my-[5px]"><a href={business.emailHref} class="text-[#cbd5e1] hover:text-white">{business.email}</a></p>
        <p class="text-[14.5px] my-[5px]">{business.area}</p>
      </div>
      <div>
        <h4 class="text-white text-[12.5px] tracking-[0.1em] uppercase mb-3">Services</h4>
        {services.map((service) => <p class="text-[14.5px] my-[5px]">{service.title}</p>)}
      </div>
    </div>
    <div class="max-w-[1160px] mx-auto px-[26px] border-t border-mod-slate mt-9 pt-5 text-[13px] text-mod-grey">
      © {new Date().getFullYear()} {business.legalName} · Rough-draft mockup prepared for review.
      <a href={import.meta.env.BASE_URL} class="text-[#cbd5e1] hover:text-white underline ml-2">Compare all three designs →</a>
    </div>
  </footer>
</Base>

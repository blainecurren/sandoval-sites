---
import Base from '../layouts/Base.astro';
import { business, variants } from '../data/content';

// BASE_URL carries a trailing slash; trim it so `${base}/industrial` is clean.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Sandoval Fencing & Welding — Design Options"
  description="Three homepage design directions for Sandoval Fencing & Welding. Compare and choose."
  bodyClass="bg-ind-ink text-ind-paper"
>
  <main class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-ind-amber">
      Serving {business.area} since {business.since}
    </p>
    <h1 class="text-[clamp(30px,5vw,46px)] font-extrabold uppercase leading-tight tracking-tight">
      {business.name}<br />
      <span class="text-ind-amber">Choose a design</span>
    </h1>
    <p class="mb-12 mt-4 max-w-2xl text-lg text-ind-muted">
      Three homepage directions for the same business. Open each, compare, and pick the one that fits.
      All three pull from the same content — copy and contact details stay in sync.
    </p>

    <div class="grid gap-5 sm:grid-cols-3">
      {
        variants.map((v) => (
          <a
            href={`${base}/${v.slug}`}
            class="group rounded-lg border border-ind-line border-t-4 border-t-ind-amber bg-ind-steel p-7 transition duration-200 hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/40"
          >
            <h2 class="mb-2 text-xl font-extrabold uppercase">{v.name}</h2>
            <p class="mb-5 text-sm text-ind-muted">{v.desc}</p>
            <span class="inline-block rounded bg-ind-amber px-5 py-2.5 text-xs font-extrabold uppercase tracking-wide text-[#1a1a1a] transition group-hover:bg-ind-amber-d">
              View site →
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-12 border-t border-ind-line pt-5 text-sm text-[#6b7480]">
      Rough-draft mockups prepared for review · {business.legalName} · Contact:
      <a href={business.phoneHref} class="text-ind-amber hover:underline">{business.phone}</a>
    </div>
  </main>
</Base>
